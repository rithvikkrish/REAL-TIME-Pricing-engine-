# Upstream WebSocket API Configuration
UPSTREAM_WS_URL=wss://v3-prod.livefxhub.com/ws/algo
UPSTREAM_API_KEY=YOUR_API_KEY_HERE
UPSTREAM_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Server & Downstream WebSocket Configuration
PORT=3000
HOST=0.0.0.0

# Persistence (Redis)
REDIS_URL=redis://localhost:6379

# Logging & Monitoring
LOG_LEVEL=info
